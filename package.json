{
  "name": "running-backend",
  "version": "1.0.0",
  "description": "API multiusuario para registro manual de corridas",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "test": "npm run test:all",
    "test:all": "prisma generate && bash scripts/test-all.sh",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts"
  },
  "keywords": [
    "running",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "docker"
  ],
  "author": "Kauê Fernandes",
  "type": "module",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tsx": "4.23.12",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "ip-address": "10.5.0",
    "deepmerge-ts": "8.0.2"
  }
}
